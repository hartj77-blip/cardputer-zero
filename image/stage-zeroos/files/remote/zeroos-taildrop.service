# Receive files sent to the Cardputer with Taildrop into ~/Downloads, while
# Tailscale is on.
[Unit]
Description=Receive Taildrop files into ~/Downloads
BindsTo=tailscaled.service
After=tailscaled.service

[Service]
User=pi
ExecStartPre=/bin/mkdir -p /home/pi/Downloads
ExecStart=/usr/bin/tailscale file get --loop --conflict=rename /home/pi/Downloads
Restart=on-failure
RestartSec=10

[Install]
WantedBy=tailscaled.service
