#!/usr/bin/env bash
# zeroos-measure: a performance report for the Cardputer Zero.
#
# Works on ZeroOS and on M5's stock image, so the two can be compared.
# Prints Markdown and saves it to ~/zeroos-measure-<host>-<date>.md.
#
#   zeroos-measure              full report; samples idle power for 60 s
#   zeroos-measure -s 120       sample power for 120 s
#   zeroos-measure --quick      skip the power and idle-CPU samples
#
# For a fair idle-power number: unplug USB power, leave the device untouched,
# screen on, Wi-Fi connected, no music playing.
set -u
SAMPLE=60
QUICK=0
while [ $# -gt 0 ]; do
    case "$1" in
        -s) SAMPLE="$2"; shift ;;
        --quick|-q) QUICK=1 ;;
        -h|--help) sed -n 2,13p "$0"; exit 0 ;;
    esac
    shift
done

OUT="${HOME:-/tmp}/zeroos-measure-$(hostname)-$(date +%Y%m%d-%H%M).md"
exec > >(tee "$OUT")

rd() { cat "$1" 2>/dev/null; }
kb2mb() { awk -v k="$1" 'BEGIN { printf "%.1f", k / 1024 }'; }
mi() { awk -v k="$1:" '$1 == k { print $2 }' /proc/meminfo; }

echo "# Cardputer Zero performance report"
echo
echo "| | |"
echo "| --- | --- |"
echo "| Date | $(date '+%Y-%m-%d %H:%M %Z') |"
model=$( { tr -d '\0' < /proc/device-tree/model; } 2>/dev/null )
echo "| Model | ${model:-unknown} |"
if [ -r /etc/zeroos-release ]; then
    echo "| OS | $(head -1 /etc/zeroos-release) |"
else
    echo "| OS | $(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-unknown}") (not ZeroOS) |"
fi
echo "| Kernel | $(uname -r) |"
echo "| Uptime | $(awk '{ printf "%dh %02dm", $1/3600, ($1%3600)/60 }' /proc/uptime) |"
echo

echo "## Boot"
echo
if command -v systemd-analyze >/dev/null; then
    echo '```'
    systemd-analyze time 2>/dev/null | head -3
    echo
    echo "Slowest units:"
    systemd-analyze blame 2>/dev/null | head -10
    echo '```'
else
    echo "systemd-analyze not available."
fi
echo

echo "## Memory"
echo
total=$(mi MemTotal); avail=$(mi MemAvailable); free=$(mi MemFree)
cached=$(mi Cached); swapt=$(mi SwapTotal); swapf=$(mi SwapFree); cma=$(mi CmaTotal)
echo "| | MB |"
echo "| --- | ---: |"
echo "| RAM visible to Linux | $(kb2mb "$total") |"
echo "| Available to apps | $(kb2mb "$avail") |"
echo "| In use (total - available) | $(kb2mb $((total - avail))) |"
echo "| Free (unused) | $(kb2mb "$free") |"
echo "| File cache | $(kb2mb "$cached") |"
echo "| CMA reserve (display/camera) | $(kb2mb "${cma:-0}") |"
echo "| Swap total | $(kb2mb "$swapt") |"
echo "| Swap used | $(kb2mb $((swapt - swapf))) |"
echo
echo "GPU memory split: $(vcgencmd get_mem gpu 2>/dev/null || grep -h '^gpu_mem' /boot/firmware/config.txt 2>/dev/null || echo unknown)"
echo

if [ -r /sys/block/zram0/mm_stat ]; then
    read -r orig compr used _ <<<"$(rd /sys/block/zram0/mm_stat)"
    algo=$(sed -n 's/.*\[\([a-z0-9-]*\)\].*/\1/p' /sys/block/zram0/comp_algorithm 2>/dev/null)
    disk=$(rd /sys/block/zram0/disksize)
    echo "### zram"
    echo
    echo "| | |"
    echo "| --- | --- |"
    echo "| Algorithm | ${algo:-unknown} |"
    echo "| Capacity | $(awk -v b="$disk" 'BEGIN { printf "%.0f MB", b/1048576 }') |"
    echo "| Data stored | $(awk -v b="$orig" 'BEGIN { printf "%.1f MB", b/1048576 }') |"
    echo "| RAM it takes | $(awk -v b="$used" 'BEGIN { printf "%.1f MB", b/1048576 }') |"
    echo "| Compression | $(awk -v o="$orig" -v c="$compr" 'BEGIN { if (c > 0) printf "%.2fx", o/c; else print "n/a (empty)" }') |"
    if [ -r /sys/block/zram0/bd_stat ]; then
        read -r bd_count bd_reads bd_writes <<<"$(rd /sys/block/zram0/bd_stat)"
        echo "| Written back to SD | $(awk -v p="$bd_count" 'BEGIN { printf "%.1f MB", p*4/1024 }') |"
    fi
    echo
fi
echo "Swap devices:"
echo '```'
swapon --show 2>/dev/null || cat /proc/swaps
echo '```'
echo

echo "### Biggest processes (resident memory)"
echo
echo "| MB | Process |"
echo "| ---: | --- |"
ps -eo rss=,comm= --sort=-rss 2>/dev/null | head -12 | awk '{ printf "| %.1f | %s |\n", $1/1024, $2 }'
echo
pid=$(pidof zeroshell 2>/dev/null | awk '{print $1}')
if [ -n "$pid" ]; then
    rss=$(awk '/^VmRSS/ { print $2 }' /proc/"$pid"/status)
    hwm=$(awk '/^VmHWM/ { print $2 }' /proc/"$pid"/status)
    pss=$(awk '/^Pss:/ { print $2 }' /proc/"$pid"/smaps_rollup 2>/dev/null)
    echo "ZeroShell: $(kb2mb "$rss") MB resident now, $(kb2mb "$hwm") MB peak, $(kb2mb "${pss:-0}") MB proportional (PSS)."
    echo
fi
running=$(systemctl list-units --type=service --state=running --no-legend 2>/dev/null | wc -l)
echo "Services running: $running"
echo
echo "<details><summary>Running services</summary>"
echo
echo '```'
systemctl list-units --type=service --state=running --no-legend --plain 2>/dev/null | awk '{ print $1 }'
echo '```'
echo
echo "</details>"
echo

echo "## CPU"
echo
gov=$(rd /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor)
cur=$(rd /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq)
max=$(rd /sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq)
temp=$(rd /sys/class/thermal/thermal_zone0/temp)
echo "| | |"
echo "| --- | --- |"
echo "| Governor | ${gov:-unknown} |"
echo "| Clock now / max | $(( ${cur:-0} / 1000 )) / $(( ${max:-0} / 1000 )) MHz |"
echo "| Temperature | $(awk -v t="${temp:-0}" 'BEGIN { printf "%.1f C", t/1000 }') |"
echo "| Load average | $(cut -d' ' -f1-3 /proc/loadavg) |"
echo "| Throttling | $(vcgencmd get_throttled 2>/dev/null || echo unknown) |"

cpu_busy() {  # prints "busy total" jiffies
    awk '/^cpu / { idle = $5 + $6; t = 0; for (i = 2; i <= NF; i++) t += $i; print t - idle, t }' /proc/stat
}
bat=""
for d in /sys/class/power_supply/bq27*; do [ -d "$d" ] && bat="$d"; done

if [ "$QUICK" = 1 ]; then
    echo
    echo "_Quick mode: idle CPU and power not sampled._"
    exit 0
fi

echo
echo "## Idle CPU and power (${SAMPLE} s sample)"
echo
read -r b0 t0 <<<"$(cpu_busy)"
n=0; sum_mw=0; min_mw=999999; max_mw=0
status=$(rd "$bat/status")
cap0=$(rd "$bat/capacity")
for _ in $(seq "$SAMPLE"); do
    if [ -n "$bat" ]; then
        v=$(rd "$bat/voltage_now"); i=$(rd "$bat/current_now")
        if [ -n "$v" ] && [ -n "$i" ]; then
            mw=$(awk -v v="$v" -v i="$i" 'BEGIN { p = v/1e6 * i/1e6 * 1000; if (p < 0) p = -p; printf "%d", p }')
            sum_mw=$((sum_mw + mw)); n=$((n + 1))
            [ "$mw" -lt "$min_mw" ] && min_mw=$mw
            [ "$mw" -gt "$max_mw" ] && max_mw=$mw
        fi
    fi
    sleep 1
done
read -r b1 t1 <<<"$(cpu_busy)"
busy=$(awk -v b=$((b1 - b0)) -v t=$((t1 - t0)) 'BEGIN { if (t > 0) printf "%.1f", 100*b/t; else print "?" }')
echo "| | |"
echo "| --- | --- |"
echo "| CPU busy (all 4 cores) | ${busy}% |"
if [ "$n" -gt 0 ]; then
    avg=$((sum_mw / n))
    echo "| Battery status | ${status:-unknown} |"
    echo "| Power draw (avg / min / max) | ${avg} / ${min_mw} / ${max_mw} mW |"
    # 1750 mAh at a 3.7 V nominal = 6475 mWh
    echo "| Estimated runtime at this draw | $(awk -v p="$avg" 'BEGIN { if (p > 0) printf "%.1f h", 6475/p; else print "?" }') |"
    echo "| Battery % start / end | ${cap0:-?} / $(rd "$bat/capacity") |"
    [ "$status" = "Charging" ] || [ "$status" = "Full" ] && echo && echo "_USB power was connected, so the power numbers measure charging, not use. Unplug and run again._"
else
    echo "| Power draw | no fuel gauge found |"
fi
echo
echo "Saved to $OUT" >&2
