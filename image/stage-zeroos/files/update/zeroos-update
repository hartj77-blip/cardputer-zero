#!/bin/bash
# zeroos-update: update ZeroOS without re-flashing the SD card (docs/UPDATE.md).
#
#   zeroos-update check                 is there a newer version?
#   zeroos-update install               download the newest version and install it
#   zeroos-update install-file X.deb    install a package that is already here
#   zeroos-update rollback              go back to the version before the last update
#   zeroos-update status                print the state file
#
# An update is one package, zeroos_<version>_arm64.deb. It comes from the
# address in /etc/zeroos/update.conf over whatever network is up (Wi-Fi,
# Ethernet, a tethered phone, Tailscale), or from a file a PC copied over.
# The download is checked against the manifest's SHA-256. After installing,
# ZeroShell is restarted and watched: if it doesn't stay up, the previous
# package goes back on.
#
# Everything but "status" needs root. ZeroShell starts zeroos-update.service
# and zeroos-update-check.service and reads /run/zeroos/update.status.
set -u

CONF=${ZEROOS_UPDATE_CONF:-/etc/zeroos/update.conf}
STATE_DIR=${ZEROOS_UPDATE_STATE:-/var/lib/zeroos/update}
RUN_DIR=${ZEROOS_UPDATE_RUN:-/run/zeroos}
RELEASE=${ZEROOS_RELEASE:-/etc/zeroos-release}
SETTLE=${ZEROOS_UPDATE_SETTLE:-10}      # seconds ZeroShell must stay up
STATUS=$RUN_DIR/update.status

UPDATE_URL=https://github.com/hartj77-blip/cardputer-zero/releases/latest/download
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"
UPDATE_URL=${UPDATE_URL%/}

current=""
latest=""
m_file="" m_sha="" m_size=0

log() { echo "zeroos-update: $*" >&2; }

current_version() {
    # "ZeroOS 1.2.3 (built 2026-11-20)"
    [ -r "$RELEASE" ] && awk 'NR==1 {print $2}' "$RELEASE"
}

# status <state> [percent] [message]
# States: checking, up-to-date, available, offline, downloading, installing,
# restarting, done, rolled-back, failed.
status() {
    local tmp="$STATUS.tmp.$$"
    {
        echo "state=$1"
        echo "current=$current"
        echo "latest=$latest"
        echo "percent=${2:-0}"
        echo "message=${3:-}"
    } > "$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$STATUS"
    log "$1${3:+: $3}"
}

fail() {
    status failed 0 "$1"
    exit 1
}

need_root() {
    [ "$(id -u)" = 0 ] || { echo "zeroos-update: $1 needs root (try: sudo zeroos-update $1)" >&2; exit 1; }
}

setup() {
    mkdir -p "$RUN_DIR" "$STATE_DIR" || exit 1
    # One update at a time.
    exec 9> "$RUN_DIR/update.lock"
    flock -n 9 || { echo "zeroos-update: another update is running" >&2; exit 1; }
    current=$(current_version)
    current=${current:-0}
}

# Read the manifest into m_* and latest. Nothing from it is trusted until it
# matches the shape we expect; it is never run or sourced.
fetch_manifest() {
    local text
    text=$(curl -fsSL --connect-timeout 10 --max-time 40 --retry 2 "$UPDATE_URL/zeroos-update.manifest") || return 1
    latest=$(printf '%s\n' "$text" | sed -n 's/^version=//p' | head -1)
    m_file=$(printf '%s\n' "$text" | sed -n 's/^file=//p' | head -1)
    m_sha=$(printf '%s\n' "$text" | sed -n 's/^sha256=//p' | head -1)
    m_size=$(printf '%s\n' "$text" | sed -n 's/^size=//p' | head -1)
    [[ $latest =~ ^[0-9][0-9A-Za-z.+~-]*$ ]] || { latest=""; return 2; }
    [[ $m_file =~ ^zeroos_[0-9A-Za-z.+~-]+_[a-z0-9]+\.deb$ ]] || return 2
    [[ $m_sha =~ ^[0-9a-f]{64}$ ]] || return 2
    [[ $m_size =~ ^[0-9]+$ ]] || return 2
}

# 0 = a newer version exists, 1 = up to date; exits when it can't tell.
check() {
    status checking
    fetch_manifest
    case $? in
        0) ;;
        1) latest=""; status offline 0 "Can't reach the update server"; exit 2 ;;
        *) fail "The update server sent something unexpected" ;;
    esac
    if dpkg --compare-versions "$latest" gt "$current"; then
        status available
        return 0
    fi
    status up-to-date
    return 1
}

download() {
    local out=$1 free pct got pid
    free=$(df -Pk "$STATE_DIR" | awk 'NR==2 {print $4}')
    # The package, the copy kept for rollback and the unpacked files.
    if [ "$((m_size * 4 / 1024))" -gt "${free:-0}" ]; then
        fail "Not enough free space for the update"
    fi
    rm -f "$out"
    curl -fsSL --connect-timeout 10 --retry 3 --retry-delay 2 -o "$out" "$UPDATE_URL/$m_file" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        got=$(stat -c %s "$out" 2>/dev/null || echo 0)
        pct=0
        [ "$m_size" -gt 0 ] && pct=$((got * 100 / m_size))
        [ "$pct" -gt 100 ] && pct=100
        status downloading "$pct"
        sleep 1
    done 2>/dev/null
    wait "$pid" || { rm -f "$out"; fail "The download stopped. Try again"; }
    if [ "$(sha256sum "$out" | cut -d' ' -f1)" != "$m_sha" ]; then
        rm -f "$out"
        fail "The download was damaged. Try again"
    fi
}

# Restart ZeroShell and see that it stays up. True too when ZeroShell isn't
# this machine's home screen (nothing to watch).
shell_stays_up() {
    systemctl is-enabled -q zeroshell.service 2>/dev/null || return 0
    systemctl restart zeroshell.service || return 1
    sleep 3
    local a b
    a=$(systemctl show -p MainPID --value zeroshell.service)
    sleep "$SETTLE"
    b=$(systemctl show -p MainPID --value zeroshell.service)
    [ -n "$a" ] && [ "$a" != 0 ] && [ "$a" = "$b" ] && systemctl is-active -q zeroshell.service
}

# An edited /etc/zeroos/update.conf is kept; dpkg must not stop to ask.
put_on() {
    DEBIAN_FRONTEND=noninteractive dpkg --force-confold --force-confdef -i "$1" >&2
}

# install_deb <file>: check it, install it, restart ZeroShell, roll back if
# ZeroShell won't stay up.
install_deb() {
    local deb=$1 pkg arch ver
    pkg=$(dpkg-deb -f "$deb" Package 2>/dev/null)
    arch=$(dpkg-deb -f "$deb" Architecture 2>/dev/null)
    ver=$(dpkg-deb -f "$deb" Version 2>/dev/null)
    [ "$pkg" = zeroos ] || fail "Not a ZeroOS package"
    [ "$arch" = "$(dpkg --print-architecture)" ] || fail "This package is for another kind of computer ($arch)"
    latest=$ver

    status installing 0
    if ! put_on "$deb"; then
        if [ -f "$STATE_DIR/current.deb" ]; then
            put_on "$STATE_DIR/current.deb"
        fi
        fail "Could not install $ver. Nothing was changed"
    fi

    status restarting 0
    if ! shell_stays_up; then
        if [ -f "$STATE_DIR/current.deb" ]; then
            log "ZeroShell $ver did not stay up; going back"
            put_on "$STATE_DIR/current.deb"
            systemctl restart zeroshell.service
            status rolled-back 0 "$ver would not start. The old version is back"
        else
            status failed 0 "$ver is installed but ZeroShell would not start"
        fi
        exit 1
    fi

    # Keep this package (to go back to after the next update) and the one before.
    if [ "$deb" != "$STATE_DIR/current.deb" ]; then
        [ -f "$STATE_DIR/current.deb" ] && mv -f "$STATE_DIR/current.deb" "$STATE_DIR/previous.deb"
        cp -f "$deb" "$STATE_DIR/current.deb"
    fi
    current=$ver
    status done 100 "Now on $ver"
}

case "${1:-}" in
    check)
        need_root check
        setup
        check || true
        ;;
    install)
        need_root install
        setup
        check || exit 0
        download "$STATE_DIR/download.deb"
        install_deb "$STATE_DIR/download.deb"
        rm -f "$STATE_DIR/download.deb"
        ;;
    install-file)
        need_root install-file
        [ -f "${2:-}" ] || { echo "usage: zeroos-update install-file <package.deb>" >&2; exit 1; }
        setup
        install_deb "$2"
        ;;
    rollback)
        need_root rollback
        setup
        [ -f "$STATE_DIR/previous.deb" ] || fail "No earlier version is kept on this device"
        # The two swap places, so a second rollback undoes the first.
        cp -f "$STATE_DIR/previous.deb" "$STATE_DIR/rollback.deb"
        install_deb "$STATE_DIR/rollback.deb"
        rm -f "$STATE_DIR/rollback.deb"
        ;;
    status)
        echo "installed=$(current_version)"
        [ -r "$STATUS" ] && cat "$STATUS"
        ;;
    *)
        sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'
        exit 1
        ;;
esac
